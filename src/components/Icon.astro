---
/**
 * Ikon kustom bergaya garis tipis. Dibuat khusus untuk Having Funds,
 * bukan dari icon font atau pustaka ikon standar.
 */
type Name =
  | "scale" | "book" | "lattice" | "spark" | "chart" | "doc" | "deck"
  | "link" | "users" | "globe" | "layers" | "arrow" | "check" | "cross"
  | "mail" | "phone" | "shield" | "gauge" | "hub";

interface Props {
  name: Name;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, class: cls = "", label } = Astro.props;

const paths: Record<Name, string> = {
  scale: "M12 3v18M7 21h10M5 7h14M5 7l-3 6.5h6L5 7Zm14 0-3 6.5h6L19 7Z",
  book: "M5 4.5h10.5a2.5 2.5 0 0 1 2.5 2.5V20H7.5A2.5 2.5 0 0 1 5 17.5v-13Zm0 13A2.5 2.5 0 0 1 7.5 15H18M9 9h6",
  lattice: "M12 3.5 19.5 8v8L12 20.5 4.5 16V8L12 3.5Zm0 0v17m-7.5-12.5L12 12l7.5-4.5M12 12v0",
  spark: "M3.5 17.5 9.5 11.5l4 4 7-8M15.5 7.5h5v5",
  chart: "M4 20h16M7.5 16.5v-4M12 16.5V8.5M16.5 16.5v-6",
  doc: "M7 3.5h7.5L19 8v12.5H7V3.5Zm7.5 0V8H19M10 12.5h6M10 16h6",
  deck: "M3.5 4.5h17v11h-17v-11ZM12 15.5V20M8 20h8M7.5 11.5l3-3 2.5 2.5 3.5-3.5",
  link: "M10 14.5 14 10.5M9.5 7.5l2-2a3.5 3.5 0 0 1 5 5l-2 2M14.5 16.5l-2 2a3.5 3.5 0 0 1-5-5l2-2",
  users: "M9 11.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7 0a2.5 2.5 0 1 0 0-5M3.5 20a5.5 5.5 0 0 1 11 0M16 14.8a4.5 4.5 0 0 1 4.5 5.2",
  globe: "M3.5 5.5h17v13h-17v-13ZM3.5 9.5h17M7 7.5h.01M9.5 7.5h.01M7 13.5h10M7 16.5h6",
  layers: "M12 3.5 20.5 8 12 12.5 3.5 8 12 3.5Zm-8.5 9 8.5 4.5 8.5-4.5M3.5 16l8.5 4.5 8.5-4.5",
  arrow: "M5 12h13.5M13 6.5 18.5 12 13 17.5",
  check: "M5 12.5 10 17.5 19 7",
  cross: "M6.5 6.5l11 11M17.5 6.5l-11 11",
  mail: "M3.5 5.5h17v13h-17v-13Zm0 0L12 13l8.5-7.5",
  phone: "M7.5 3.5h2.5l1.5 4-2 1.5a10 10 0 0 0 6 6l1.5-2 4 1.5v2.5a2 2 0 0 1-2 2A16 16 0 0 1 5.5 5.5a2 2 0 0 1 2-2Z",
  shield: "M12 3.5 19.5 6.5v5.5c0 4.5-3.2 7.8-7.5 9-4.3-1.2-7.5-4.5-7.5-9V6.5L12 3.5Zm-3 8.5 2.2 2.2L15.5 9.5",
  gauge: "M4.5 16a8 8 0 1 1 15 0M12 16l4-4.5M8 16h.01M12 8v.01",

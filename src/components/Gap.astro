---
import { gaps, promises } from "../data/site";
import Icon from "./Icon.astro";
---
<section class="sec" id="masalah">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2>Investor tidak membeli ide. Mereka membeli dokumen yang bisa diuji.</h2>
      <p>Proposal yang sudah rapi belum tentu siap dinilai. Perbedaan di bawah ini yang biasanya menentukan apakah sebuah proyek bisa lanjut.</p>
    </div>

    <div class="gap" data-reveal>
      {gaps.map((col, ci) => (
        <div class={`gap__col gap__col--${ci === 0 ? "before" : "after"}`}>
          <p class="gap__label">{col.label}</p>
          <ul class="gap__list">
            {col.items.map((it) => (
              <li>
                <Icon name={ci === 0 ? "cross" : "check"} size={18} />
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="promise" data-reveal>
      <div class="promise__col">
        <p class="promise__title">Yang kami berikan</p>
        <ul>
          {promises.yes.map((t) => <li><Icon name="check" size={18} /><span>{t}</span></li>)}
        </ul>
      </div>
      <div class="promise__col promise__col--no">
        <p class="promise__title">Yang tidak kami berikan</p>
        <ul>
          {promises.no.map((t) => <li><Icon name="cross" size={18} /><span>{t}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .gap {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--navy);
    border-bottom: 1px solid var(--line);
  }

  .gap__col {
    padding: 40px 40px 44px 0;
  }

  .gap__col--after {
    padding: 40px 0 44px 40px;
    border-left: 1px solid var(--line);
  }

  .gap__label {
    font: 700 0.85rem/1 var(--font-body);
    color: var(--blue);
    margin-bottom: 22px;
  }

  .gap__col--before .gap__label {
    color: var(--muted);
  }

  .gap__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .gap__list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    font-size: 1.02rem;
    color: var(--text);
  }

  .gap__col--before .gap__list li {
    color: var(--muted);
  }

  .gap__col--before .gap__list .icon {
    color: #8aa0b8;
    margin-top: 3px;
  }

  .gap__col--after .gap__list .icon {
    color: var(--blue);
    margin-top: 3px;
  }

  .promise {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    margin-top: clamp(44px, 6vw, 72px);
  }

  .promise__title {
    font: 700 1rem/1.3 var(--font-display);
    color: var(--navy);
    margin-bottom: 18px;
  }

  .promise ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .promise li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    color: var(--text);
  }

  .promise li .icon {
    color: var(--blue);
    margin-top: 3px;
  }

  .promise__col--no li {
    color: var(--muted);
  }

  .promise__col--no li .icon {
    color: #8aa0b8;
  }

  @media (max-width: 760px) {
    .gap {
      grid-template-columns: 1fr;
    }

    .gap__col,
    .gap__col--after {
      padding: 32px 0;
      border-left: none;
    }

    .gap__col--before {
      border-bottom: 1px solid var(--line);
    }

    .promise {
      grid-template-columns: 1fr;
    }
  }
</style>

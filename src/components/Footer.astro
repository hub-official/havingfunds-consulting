---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";
---
<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__tag">{site.tagline}</p>
    </div>
    <nav class="footer__nav" aria-label="Navigasi footer">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="footer__meta">
      <a href={`mailto:${site.email}`}><Icon name="mail" size={16} />{site.email}</a>
      <p>{site.address}</p>
    </div>
  </div>
  <div class="wrap footer__legal">
    <p>© {site.year} {site.name}. Seluruh dokumen dan jasa bersifat penyiapan, bukan opini audit, hukum, atau pajak.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #9fbcd3;
    padding-top: 72px;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--line-dark);
  }

  .footer__name {
    font: 600 1.05rem/1 var(--font-display);
    color: var(--white);
    margin-bottom: 12px;
  }

  .footer__tag {
    font-size: 0.95rem;
    max-width: 32ch;
  }

  .footer__nav {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .footer__nav a,
  .footer__meta a {
    color: #c9e4f5;
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
  }

  .footer__nav a:hover,
  .footer__meta a:hover {
    color: var(--sky);
  }

  .footer__meta {
    display: grid;
    gap: 10px;
    align-content: start;
    font-size: 0.95rem;
  }

  .footer__legal {
    padding-block: 24px 32px;
    font-size: 0.85rem;
    color: #6f8aa3;
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { site } from "../data/site";
import Icon from "./Icon.astro";

const nodes = [
  { icon: "scale", label: "Legalitas", a: 0 },
  { icon: "chart", label: "Keuangan", a: 60 },
  { icon: "lattice", label: "Tata kelola", a: 120 },
  { icon: "link", label: "Pasar B2B", a: 180 },
  { icon: "users", label: "Mitra pemasok", a: 240 },
  { icon: "deck", label: "Pendanaan", a: 300 },
] as const;

const areas = [
  { label: "Legalitas", v: 100 },
  { label: "Keuangan", v: 100 },
  { label: "Tata kelola", v: 100 },
  { label: "Pasar dan pembeli", v: 100 },
];
---
<section class="hero" id="top" data-glow>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title" data-reveal>
        Dari proposal menjadi <span class="hero__line">kesiapan investor.</span>
      </h1>
      <p class="hero__lead" data-reveal style="--d:120ms">
        Kami menyiapkan dokumen kesiapan investasi lintas sektor yang bisa diuji: Investment Readiness Assessment, tata kelola, feasibility study, prospektus, dan deck investasi.
      </p>
      <div class="hero__actions" data-reveal style="--d:220ms">
        <a class="btn btn--light" href="#paket">
          Lihat paket
          <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn--ghost" href="#roadmap">Pelajari roadmap</a>
      </div>
      <p class="hero__note" data-reveal style="--d:320ms">
        Kami menyiapkan dokumen, bukan menjanjikan pendanaan.
      </p>
    </div>

    <div class="hero__visual" data-reveal style="--d:160ms">
      <div class="core" aria-hidden="true">
        <span class="ring ring--outer"></span>
        <span class="ring ring--mid"></span>
        <span class="core__glow"></span>
        <div class="orbit">
          {nodes.map((n) => (
            <span class="node" style={`--a:${n.a}deg`} title={n.label}>
              <span class="node__inner">
                <Icon name={n.icon} size={22} />
              </span>
            </span>
          ))}
        </div>
        <div class="core__hub">
          <Icon name="hub" size={44} />
        </div>
      </div>

      <div class="meter" aria-label="Area yang disiapkan">
        <p class="meter__title">Area yang kami siapkan</p>
        {areas.map((a, i) => (
          <div class="meter__row">
            <span class="meter__label">{a.label}</span>
            <span class="meter__track">
              <span class="meter__fill" style={`--v:${a.v}%; animation-delay:${0.5 + i * 0.22}s`}></span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 120px;
    padding-bottom: 80px;
    color: var(--white);
    background:
      radial-gradient(1200px 600px at 85% 10%, rgba(31, 78, 137, 0.55), transparent 60%),
      linear-gradient(180deg, var(--ink) 0%, var(--navy) 100%);
    overflow: hidden;
    isolation: isolate;
  }

  /* Cahaya kursor, halus dan hanya di area hero. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      480px circle at var(--mx, 70%) var(--my, 40%),
      rgba(95, 168, 211, 0.16),
      transparent 60%
    );
    pointer-events: none;
  }

  /* Garis grid tipis sebagai latar teknis. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(201, 228, 245, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 228, 245, 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
  }

  .hero__title {
    font-size: clamp(2.2rem, 5.2vw, 4.2rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }

  .hero__line {
    display: inline-block;
    color: var(--ice);
    -webkit-text-stroke: 0;
  }

  .hero__lead {
    margin-top: 28px;
    max-width: 52ch;
    font-size: 1.1rem;
    color: #bcd3e6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .hero__actions .btn--ghost {
    color: var(--white);
    border-color: rgba(201, 228, 245, 0.35);
  }

  .hero__actions .btn--ghost:hover {
    border-color: var(--sky);
  }

  .hero__note {
    margin-top: 28px;
    font-size: 0.9rem;
    color: #8fb0cc;
  }

  /* ---------- Objek inti ---------- */

  .hero__visual {
    display: grid;
    gap: 36px;
    justify-items: center;
  }

  .core {
    --size: min(500px, 88vw);
    --r: calc(var(--size) * 0.42);
    position: relative;
    width: var(--size);
    height: var(--size);
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .ring--outer {
    border: 1px dashed rgba(95, 168, 211, 0.45);
    animation: spin 90s linear infinite;
  }

  .ring--mid {
    inset: 14%;
    border: 1px solid rgba(201, 228, 245, 0.18);
    animation: spin 50s linear infinite reverse;
  }

  .core__glow {
    position: absolute;
    inset: 30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95, 168, 211, 0.55), rgba(31, 78, 137, 0.1) 70%);
    filter: blur(6px);
    animation: pulse-core 4.5s ease-in-out infinite;
  }

  .core__hub {
    position: absolute;
    inset: 36%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(160deg, rgba(31, 78, 137, 0.9), rgba(11, 37, 69, 0.95));
    border: 1px solid rgba(201, 228, 245, 0.35);
    color: var(--ice);
    box-shadow: 0 0 60px rgba(95, 168, 211, 0.25);
  }

  .orbit {
    position: absolute;
    inset: 0;
    animation: spin 60s linear infinite;
  }

  .node {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60px;
    height: 60px;
    margin: -30px 0 0 -30px;
    transform: rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(var(--a) * -1));
  }

  .node__inner {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--ink);
    border: 1px solid rgba(95, 168, 211, 0.7);
    color: var(--ice);
    animation: spin-rev 60s linear infinite;
    box-shadow: 0 0 24px rgba(95, 168, 211, 0.18);
  }

  /* Meter dengan fill sekali saat halaman dibuka. */
  .meter {
    width: min(440px, 100%);
    display: grid;
    gap: 14px;
    padding: 22px 24px;
    border: 1px solid var(--line-dark);
    border-radius: 4px;
    background: rgba(6, 16, 31, 0.4);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .meter__title {
    font: 600 0.9rem/1.2 var(--font-body);
    color: var(--ice);
  }

  .meter__row {
    display: grid;
    grid-template-columns: 150px 1fr;
    align-items: center;
    gap: 16px;
  }

  .meter__label {
    font-size: 0.88rem;
    color: #bcd3e6;
  }

  .meter__track {
    position: relative;
    height: 6px;
    background: rgba(201, 228, 245, 0.12);
    border-radius: 99px;
    overflow: hidden;
  }

  .meter__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--blue), var(--sky), var(--ice));
    border-radius: 99px;
    animation: fill-meter 1.8s var(--ease) both;
    width: var(--v);
  }

  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__title {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .meter__row {
      grid-template-columns: 110px 1fr;
    }
  }
</style>

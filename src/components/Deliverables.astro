---
import { deliverables } from "../data/site";
import Icon from "./Icon.astro";
---
<section class="sec" id="dokumen">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2>Sebelas dokumen, satu set yang saling selaras.</h2>
      <p>Angka, nama, dan narasi dikerjakan bersama. Company profile, prospektus, dan deck investasi tidak boleh saling bertentangan.</p>
    </div>

    <ul class="docs" data-reveal>
      {deliverables.map((d, i) => (
        <li class="doc">
          <span class="doc__index">{String(i + 1).padStart(2, "0")}</span>
          <span class="doc__icon"><Icon name={d.icon as any} size={26} /></span>
          <h3 class="doc__name">{d.name}</h3>
          <p class="doc__desc">{d.desc}</p>
          <p class="doc__format">{d.format}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .docs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .doc {
    position: relative;
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 32px 30px 34px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.5s var(--ease);
  }

  .doc:hover {
    background: var(--mist);
  }

  .doc:hover .doc__icon {
    color: var(--white);
    background: var(--navy);
    border-color: var(--navy);
  }

  .doc__index {
    position: absolute;
    top: 30px;
    right: 30px;
    font: 500 0.8rem/1 var(--font-body);
    color: #8aa0b8;
    font-variant-numeric: tabular-nums;
  }

  .doc__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--blue);
    transition: all 0.5s var(--ease);
  }

  .doc__name {
    font: 600 1.02rem/1.3 var(--font-display);
    color: var(--navy);
    margin-top: 6px;
  }

  .doc__desc {
    font-size: 0.94rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .doc__format {
    font: 600 0.84rem/1.4 var(--font-body);
    color: var(--blue);
    padding-top: 6px;
  }

  @media (max-width: 960px) {
    .docs {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .docs {
      grid-template-columns: 1fr;
    }
  }
</style>

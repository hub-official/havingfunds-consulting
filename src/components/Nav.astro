---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";
---
<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="brand" href="#top" aria-label={`${site.name}, beranda`}>
      <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="1" y="1" width="38" height="38" rx="11" fill="#0B2545" />
        <path d="M20 9.5 29.5 17 20 24.5 10.5 17Z" fill="none" stroke="#5FA8D3" stroke-width="2.2" stroke-linejoin="round" />
        <path d="M11 28h18M14.5 32.5h11" stroke="#EEF5FB" stroke-width="2.2" stroke-linecap="round" />
      </svg>
      <span class="brand__text">
        <span class="brand__name">Having Funds</span>
        <span class="brand__sub">Consulting</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Navigasi utama">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="btn btn--solid nav__cta" href="#kontak">
      Diskusi awal
      <Icon name="arrow" size={18} />
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background-color 0.5s var(--ease), box-shadow 0.5s var(--ease), backdrop-filter 0.5s;
  }

  .nav.is-scrolled {
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--white);
    transition: color 0.5s var(--ease);
  }

  .nav.is-scrolled .brand {
    color: var(--navy);
  }

  .brand__mark {
    width: 40px;
    height: 40px;
  }

  .brand__text {
    display: grid;
    line-height: 1.05;
  }

  .brand__name {
    font: 600 0.98rem/1 var(--font-display);
    letter-spacing: 0.01em;
  }

  .brand__sub {
    font: 500 0.72rem/1.4 var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .nav__links {
    display: flex;
    gap: 34px;
  }

  .nav__links a {
    position: relative;
    font: 600 0.92rem/1 var(--font-body);
    text-decoration: none;
    color: rgba(255, 255, 255, 0.82);
    padding-block: 8px;
    transition: color 0.3s;
  }

  .nav.is-scrolled .nav__links a {
    color: var(--muted);
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease);
  }

  .nav__links a:hover {
    color: var(--white);
  }

  .nav.is-scrolled .nav__links a:hover {
    color: var(--navy);
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__cta {
    padding: 12px 18px;
    font-size: 0.88rem;
    background: var(--ice);
    color: var(--ink);
  }

  .nav.is-scrolled .nav__cta {
    background: var(--navy);
    color: var(--white);
  }

  @media (max-width: 920px) {
    .nav__links {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav__cta {
      display: none;
    }
  }
</style>

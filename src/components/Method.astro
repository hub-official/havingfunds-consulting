---
import { steps } from "../data/site";
---
<section class="sec sec--dark" id="cara-kerja">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2>Cara kerja yang bisa diikuti manajemen.</h2>
      <p>Setiap tahap punya output yang jelas dan bisa dicek oleh tim internal. Tidak ada dokumen yang tiba-tiba muncul tanpa proses review.</p>
    </div>

    <ol class="method">
      {steps.map((s, i) => (
        <li class="method__item" data-reveal style={`--d:${i * 110}ms`}>
          <span class="method__bar" aria-hidden="true"></span>
          <h3 class="method__title">{s.title}</h3>
          <p class="method__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .method__item {
    position: relative;
    padding: 0 28px 0 0;
  }

  .method__item + .method__item {
    padding-left: 28px;
    border-left: 1px solid var(--line-dark);
  }

  .method__bar {
    display: block;
    width: 100%;
    height: 2px;
    margin-bottom: 30px;
    background: linear-gradient(90deg, var(--sky), transparent);
  }

  .method__title {
    font: 600 1.15rem/1.3 var(--font-display);
    color: var(--white);
    margin-bottom: 12px;
  }

  .method__text {
    color: #9fbcd3;
    font-size: 0.96rem;
  }

  @media (max-width: 900px) {
    .method {
      grid-template-columns: 1fr 1fr;
      row-gap: 48px;
    }

    .method__item:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .method {
      grid-template-columns: 1fr;
    }

    .method__item + .method__item {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
